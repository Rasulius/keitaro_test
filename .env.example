# Пример конфигурации (альтернатива странице "Настройки" / runtime_config.json).
# Секреты не коммитьте в Git. Рекомендуется задавать KEITARO_URL и KEITARO_API_KEY
# через /admin (сохраняются в runtime_config.json, который в .gitignore).

# Keitaro Admin API
KEITARO_URL=https://your-tracker-domain.com
KEITARO_API_KEY=

# App / DB
DATABASE_URL=sqlite:///./app.db

# Значения по умолчанию (можно задать в UI настроек/форме создания кампании)
DEFAULT_DOMAIN_ID=
DEFAULT_GROUP_ID=
DEFAULT_TRAFFIC_SOURCE_ID=
DEFAULT_OFFER_ID=
GOOGLE_REDIRECT_URL=https://google.com

# Префикс имён кампаний (пример из ТЗ: test_ivanov_)
CAMPAIGN_NAME_PREFIX=test_shagimardanov_
